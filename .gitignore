# Node dependencies and generated web/native build output.
node_modules/
build/
dist/
coverage/

# Release artifacts copied here by scripts/build-android-release.mjs.
release/

# Generated from @litertjs/core by scripts/prepare-litert-assets.mjs.
public/litert-wasm/

# Third-party repos cloned only for study (see docs/reference/).
reference/

# Environment files: commit templates with placeholder values only.
.env
.env.*
!.env.example
!.env.*.example

# Credential and private-key material.
.secret
.secrets
*.secret
*.secrets
*.credentials
*.credentials.json
*.key
*.pem
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.xcuserstate
*.mobileprovision
key.properties
keystore.properties

# Common credential filenames wherever they occur.
secret.json
secrets.json
credentials.json

# Common root-level local credential stores.
/secret/
/secrets/
/credentials/

# OS metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Package-manager debug logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Offline dataset tooling (venv, weights, generated datasets).
tools/dataset/out*/
*.pt

# Python bytecode, local environments, and test cache.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local tool state (not shared)
.impeccable/config.local.json
.aistudio/

# Signing material must never be committed.
*.jks
*.keystore
keystore.properties
